{
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "migrate:reset": "npm run migrate:undo && npm run migrate && npm run seed",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --coverage --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^20.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.6",
    "sequelize-mig": "^3.1.3",
    "stripe": "^22.0.2",
    "telegram-bot-api": "^2.0.1",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "nodemon": "^3.1.10",
    "sequelize-auto-migrations": "^1.0.3",
    "supertest": "^7.1.4"
  }
}
